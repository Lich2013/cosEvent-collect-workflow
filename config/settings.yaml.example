# Local SQLite Database Path
db_path: "runtime/cosevent.db"

# Playwright Scraper Configuration
default_limit: 10
page_load_timeout_seconds: 15

# OpenAI Agent Analysis Configuration
analyze_confidence_threshold: 0.3

# Local self-hosted Langfuse configuration host
langfuse_host: "http://localhost:3000"

# ==============================================================================
# LLM Providers Configuration (Endlines, API Keys, Default Models)
# ==============================================================================
llm_providers:
  openai:
    base_url: "https://api.openai.com/v1"
    api_key: "${OPENAI_API_KEY}"
    default_model: "gpt-4o-mini"
  
  deepseek:
    base_url: "https://api.deepseek.com/v1"
    api_key: "${DEEPSEEK_API_KEY}"
    default_model: "deepseek-chat"

# ==============================================================================
# Intelligent Consensus & Triage Analysis Pipeline
# ==============================================================================
analysis_pipeline:
  # Mode: "single" (uses only openai default model), "consensus" (multi-llm extractors + judge)
  mode: "consensus"

  # Triage model used to pre-filter posts that contain NO events
  triage_provider: "deepseek"
  triage_model: "deepseek-chat"

  # Parallel extractors to crawl candidate events (only active when triage returns non-empty)
  extractors:
    - provider: "openai"
      model: "gpt-4o-mini"
    - provider: "deepseek"
      model: "deepseek-chat"

  # Final high-reasoning judge that performs fuzzy deduplication, merging, and strict Pydantic output
  judge:
    provider: "openai"
    model: "gpt-4o"

# ==============================================================================
# Bilibili gRPC First-Party API Credentials
# ==============================================================================
bilibili_grpc:
  access_token: "${BILIBILI_ACCESS_TOKEN}"
  refresh_token: "${BILIBILI_REFRESH_TOKEN}"
  mid: "${BILIBILI_MID}"
  mobi_app: "${BILIBILI_MOBI_APP}"
  device: "${BILIBILI_DEVICE}"
  build: "${BILIBILI_BUILD}"

# ==============================================================================
# Fusion Bypass Generic Names List (Bypass Gated Fusion logic to prevent collapse)
# ==============================================================================
bypass_generic_names:
  - "签售"
  - "一日店长"
  - "店长"
  - "摄影会"
  - "受邀模特"
  - "快闪"
  - "签售会"

