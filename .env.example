# ==============================================================================
# Cosplay 活动收集分析系统环境变量模板 (.env.example)
# ==============================================================================

# 🔹 OpenAI 凭证配置
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# 如果使用第三方 OpenAI 兼容代理，可在此配置 Base URL
# OPENAI_BASE_URL=https://api.openai.com/v1

# 🔹 DeepSeek 凭证配置
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# 如果使用 DeepSeek 官方，Base URL 通常为：https://api.deepseek.com/v1
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# 🔹 本地自建大模型配置（例如使用 Ollama，可不填 api_key）
# OLLAMA_BASE_URL=http://localhost:11434/v1

# 🔹 Langfuse 链路追踪可观测性配置 (可选，若不填会自动友好降级为本地日志)
LANGFUSE_PUBLIC_KEY=pk-lf-xxxxxxxxxxxxxxxxxxxxxxxxxxxx
LANGFUSE_SECRET_KEY=sk-lf-xxxxxxxxxxxxxxxxxxxxxxxxxxxx
# LANGFUSE_HOST=http://localhost:3000

# 🔹 Bilibili 移动端第一方 gRPC 凭证 (可选，若缺失将自动降级为 Playwright 网页抓取)
BILIBILI_ACCESS_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
BILIBILI_MID=xxxxxxxx
